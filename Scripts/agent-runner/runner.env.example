# Host-specific, UNTRACKED (copied to $AGENT_BASE/runner.env, 0600). Never commit real values.
# The runner works OUTSIDE this window: default = weekday working hours in BUSY_TZ are busy, so
# runs happen nights and weekends. Set BUSY_TZ to the owner's zone or the window is meaningless.
BUSY_HOURS="09-18"          # "HH-HH" local hours with no new Claude runs; "00-00" disables the gate
BUSY_TZ="UTC"               # e.g. "America/New_York"
BUSY_DAYS="1-5"             # ISO weekdays (1 = Monday) the window applies to
HOST_SOFT_PAUSE_FILE=""     # a file whose existence means "the subscription is near its cap"
CLICKUP_POLL_HOURS=2
# The uid the model (`claude`) runs as. MUST differ from the runner user and MUST NOT be able to
# read $AGENT_BASE/secrets, secrets.env or state/. Needs a sudoers rule (install.sh prints it).
# Empty = tick.sh refuses to dispatch. ALLOW_SAME_UID=1 overrides that on purpose and is a
# documented residual risk (the model can then read the App key). Do not set it casually.
AGENT_RUN_AS=""
ALLOW_SAME_UID=0
