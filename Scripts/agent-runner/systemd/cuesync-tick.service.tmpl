[Unit]
Description=CueSync AR agent runner tick (one Claude run at most)
[Service]
Type=oneshot
WorkingDirectory=@AGENT_BASE@
Environment=AGENT_BASE=@AGENT_BASE@
Environment=PATH=@PATH@
Environment=HOME=%h
Environment=GH_CONFIG_DIR=@AGENT_BASE@/gh-config
Environment=GIT_CONFIG_GLOBAL=@AGENT_BASE@/gitconfig
EnvironmentFile=-@AGENT_BASE@/claude-token.env
ExecStart=@AGENT_BASE@/tick.sh
ExecStopPost=-/bin/sh -c 'docker rm -f $(docker ps -q -f name=cuesync-swift) 2>/dev/null; true'
TimeoutStartSec=50m
KillMode=control-group
Nice=10
Slice=ai-agents.slice
MemoryMax=10G
CPUQuota=400%
