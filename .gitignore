# macOS
.DS_Store

# Xcode
xcuserdata/
DerivedData/
*.xcuserstate
*.xcscmblueprint
*.xccheckout
timeline.xctimeline
playground.xcworkspace

# XcodeGen output (generated — run Scripts/bootstrap.sh)
CueSyncAR.xcodeproj/

# SwiftPM
.build/
.swiftpm/

# CocoaPods (removed from the project; ignore any local reinstall)
Pods/
*.xcworkspace

# Secrets (copy Config/Secrets.example.xcconfig → Config/Secrets.xcconfig)
App/Config/Secrets.xcconfig

# Misc
*.log
.env

# Session bundles pulled from the device (Scripts/pull-session.sh) — up to
# ~225 MB of video each. Fixtures are copied under Packages/SessionReplay/
# Tests/.../Fixtures deliberately, without the video.
#
# Anchored with a leading slash: unanchored, this pattern matches a
# directory named Sessions at ANY depth, so it also swallowed those
# fixtures and they silently failed to stage.
/Sessions/

# Agent runner hand-off files inside a worktree (never committed; see docs/agent-runner.md)
.agent-outbox/
.agent-inbox/
.pr-body.md

# Xcode derivedDataPath output from scripted builds (contains resolved
# xcconfig values, including secrets, in XCBuildData manifests)
build/
